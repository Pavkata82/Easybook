@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Потвърждение за изпратен имейл";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow rounded-4 p-4 text-center" style="max-width: 500px; width: 100%;">
        <div class="card-body">
            <div class="mb-4">
                <i class="bi bi-envelope-check-fill" style="font-size: 3rem; color: #0d6efd;"></i>
            </div>
            <h1 class="card-title mb-3">@ViewData["Title"]</h1>
            <p class="text-secondary">
                Моля, проверете имейла си за линк за промяна на паролата.<br />
                Ако не виждате писмото, проверете и папката със спам.
            </p>
            <hr class="my-4" />
            <a href="@Url.Action("Index", "Home", new {area = ""})" class="btn btn-outline-primary rounded-pill px-4">
                Начало
            </a>
        </div>
    </div>
</div>
