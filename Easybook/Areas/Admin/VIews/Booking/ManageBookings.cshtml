@model IEnumerable<Easybook.Models.Booking>

@{
    ViewData["Title"] = "Управление на Резервации";
    ViewData["ActivePage"] = "ManageBookings";
}

<h2>Управление на Резервации</h2>
<p>Тук можете да одобрите, отмените или редактирате резервации.</p>

<!-- Search Form -->
<form method="get" class="mb-3">
    <div class="d-flex justify-content-between">
        <div class="input-group">
            <input type="text" class="form-control" name="bookingId" placeholder="Търсене по Резервационен ID" value="@Context.Request.Query["bookingId"]" />
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i> Търси
            </button>
        </div>
    </div>
</form>

<!-- Table for listing bookings -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>Всички Резервации</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Резервационен ID</th>
                            <th>Име на клиента</th>
                            <th>Период на резервацията</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>@booking.BookingId</td>
                                <td>@(booking.User?.FirstName + " " + booking.User?.LastName ?? "Няма данни")</td>

                                <!-- Display the booking date range -->
                                <td>
                                    @if (booking.BookingDateRanges?.Any() == true)
                                    {
                                        var firstRange = booking.BookingDateRanges.FirstOrDefault();
                                        var startDate = firstRange?.StartDate.ToString("dd/MM/yyyy");
                                        var endDate = firstRange?.EndDate.ToString("dd/MM/yyyy");

                                        @($"{startDate} - {endDate}")
                                    }
                                    else
                                    {
                                        <span>Няма налични дати</span>
                                    }
                                </td>

                                <!-- Status Dropdown for Changing Status & Colored Status Display -->
                                <td>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <!-- Status Badge with Color -->
                                        <span class="badge
                                          @(booking.Status.Name == "Отменено" ? "bg-danger" : "")
                                          @(booking.Status.Name == "В очакване" ? "bg-warning" : "")
                                          @(booking.Status.Name == "Плащане" ? "bg-info" : "")
                                          @(booking.Status.Name == "Одобрено" ? "bg-success" : "")
                                          style="min-width: 100px; text-align: center;">
                                            @booking.Status.Name
                                        </span>

                                        <!-- Status Dropdown for Changing Status -->
                                        <form asp-action="UpdateBookingStatus" method="post" class="ms-2">
                                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                            <select name="statusId" class="form-select form-select-sm" onchange="confirmStatusChangeForSelect(this)" style="width: 120px;" data-previous-value="@booking.StatusId">
                                                @foreach (var status in ViewBag.Statuses as List<Easybook.Models.Status>)
                                                {
                                                    @if (status.Id == booking.StatusId)
                                                    {
                                                        <option value="@status.Id" selected>
                                                            @status.Name
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@status.Id">
                                                            @status.Name
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </form>

                                    </div>
                                </td>

                                <!-- Actions -->
                                <td class="d-flex gap-2">
                                    <form asp-action="Delete" asp-controller="Booking" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да отмените тази резервация?');">
                                        <input type="hidden" name="id" value="@booking.BookingId" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Отмени
                                        </button>
                                    </form>

                                    <a href="@Url.Action("BookingDetails", "Booking", new { area = "Admin", id = booking.BookingId })" class="btn btn-info btn-sm" title="Прегледай Детайли">
                                        <i class="bi bi-eye"></i> Прегледай
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/js/status-change.js"></script>
