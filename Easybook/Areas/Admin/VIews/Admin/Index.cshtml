@{
    var bookingsData = ViewData["BookingsData"] as List<dynamic>;
    var checkInData = ViewData["CheckInData"] as List<dynamic>;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-md-10 offset-md-1">
            <h3 class="text-center">Резервации по дата на резервация</h3>
            <canvas id="bookingsChart" class="w-100" style="max-height: 300px;"></canvas>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-12 col-md-10 offset-md-1">
            <h3 class="text-center">Резервации по дата на настаняване</h3>
            <canvas id="checkInChart" class="w-100" style="max-height: 300px;"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var monthNames = [
        "Януари", "Февруари", "Март", "Април", "Май", "Юни",
        "Юли", "Август", "Септември", "Октомври", "Ноември", "Декември"
    ];

    var bookingsData = @Html.Raw(Json.Serialize(ViewData["BookingsData"]));
    var checkInData = @Html.Raw(Json.Serialize(ViewData["CheckInData"]));

    function createChart(canvasId, data, label, color) {
        var months = data.map(item => monthNames[item.month - 1]);
        var bookingCounts = data.map(item => item.bookingCount);

        var ctx = document.getElementById(canvasId).getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: label,
                    data: bookingCounts,
                    backgroundColor: color,
                    borderColor: color.replace("0.2", "1"),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, stepSize: 1 }
                }
            }
        });
    }

    createChart("bookingsChart", bookingsData, "Резервации на месец (по дата на резервация)", "rgba(54, 162, 235, 0.2)");
    createChart("checkInChart", checkInData, "Резервации на месец (по дата на настаняване)", "rgba(255, 99, 132, 0.2)");
</script>
