@using Easybook.Areas.Admin.Models.ViewModels
@model HotelEditViewModel

@{
    ViewData["Title"] = "Редактиране на Хотел";
    ViewData["ActivePage"] = "EditHotel";

    List<int> selectedFacilities = new List<int>();

    if (!string.IsNullOrEmpty(Model.SelectedFacilityIds))
    {
        selectedFacilities = Model.SelectedFacilityIds
            .Split(',')
            .Where(id => !string.IsNullOrEmpty(id))  // Ensure there are no empty strings
            .Select(id => int.TryParse(id, out var facilityId) ? facilityId : 0) // Safely parse and handle invalid IDs
            .Where(id => id != 0)  // Remove any failed parses (id = 0)
            .ToList();
    }
}

<link rel="stylesheet" href="~/css/hotel-edit.css" />

<div class="hotel-edit-form">
    <h2>Редактиране на Хотел</h2>

    <form id="hotel-edit-form" asp-action="Edit" asp-route-id="@Model.HotelId" enctype="multipart/form-data">

        <input hidden name="HotelId" value=@Model.HotelId />

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name">Име на Хотела</label>
                <input asp-for="Name" class="form-control" placeholder="Въведете име на хотела" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address">Адрес</label>
                <input asp-for="Address" class="form-control" placeholder="Въведете адрес" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="City">Град</label>
                <input asp-for="City" class="form-control" placeholder="Въведете град" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Country">Държава</label>
                <input asp-for="Country" class="form-control" placeholder="Въведете държава" />
                <span asp-validation-for="Country" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description">Описание</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Въведете описание"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Удобства</label>
            <div class="facilities-grid">
                @foreach (var facility in Model.AllFacilities)
                {
                    <div class="facility-card @(selectedFacilities.Contains(facility.FacilityId) ? "selected" : "")" data-id="@facility.FacilityId">
                        <div>@facility.Name</div>
                    </div>
                }

            </div>
            <input type="hidden" name="SelectedFacilityIds" id="selected-facilities" value="@string.Join(",", Model.SelectedFacilityIds)" />
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label>Единични Стаи</label>
                <input asp-for="SingleRoomCount" type="number" min=@Model.SingleRoomCount class="form-control" />
                <span asp-validation-for="SingleRoomCount" class="text-danger"></span>

                <label>Цена за Единична Стая</label>
                <input asp-for="SingleRoomPrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="SingleRoomPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Двойни Стаи</label>
                <input asp-for="DoubleRoomCount" type="number" min=@Model.DoubleRoomCount class="form-control" />
                <span asp-validation-for="DoubleRoomCount" class="text-danger"></span>

                <label>Цена за Двойна Стая</label>
                <input asp-for="DoubleRoomPrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="DoubleRoomPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Семейни Стаи</label>
                <input asp-for="FamilyRoomCount" type="number" min=@Model.FamilyRoomCount class="form-control" />
                <span asp-validation-for="FamilyRoomCount" class="text-danger"></span>

                <label>Цена за Семейна Стая</label>
                <input asp-for="FamilyRoomPrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="FamilyRoomPrice" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div id="existing-images">
                @foreach (var image in Model.Images)
                {
                    <div class="existing-image">
                        <img src="@image.ImageUrl"
                             alt="Image"
                             class="existing-image-thumbnail"
                             data-image-id="@image.ImageId"
                             data-is-main="@(image.IsMain.ToString().ToLower())" />

                        <!-- Updated delete button (X) -->
                        <button type="button" class="delete-btn" data-image-id="@image.ImageId">
                            <span>&times;</span>
                        </button>
                    </div>
                }
            </div>

            <p id="main-image-warning">Моля изберете основно изображение</p>

            <!-- Message about main image -->
            <div class="image-info-msg">
                <p><strong>Важно:</strong> Изображението с синя рамка е основно. Можете да го промените, като щракнете върху друго изображение.</p>
            </div>

            <input asp-for="NewImages" type="file" class="form-control" multiple id="image-input" />
            <span asp-validation-for="NewImages" class="text-danger"></span>

            <div id="image-preview"></div>

            <!-- Hidden input to store the selected main image index -->
            <input type="hidden" id="main-image-index" name="MainImageIndex" value="@Model.MainImageIndex" />

            <!-- Hidden input to store the image for deletion -->
            <input type="hidden" id="images-for-deletion" name="ImagesForDeletion" value="" />
        </div>



        <button type="submit" class="btn btn-primary w-100">Запази промени</button>
    </form>
</div>

<script src="~/js/hotel-edit.js"></script>
