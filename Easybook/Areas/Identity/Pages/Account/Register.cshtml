@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; background-color: #f8f9fa;">
    <div class="card shadow-lg border-0" style="width: 100%; max-width: 450px; border-radius: 12px;">
        <div class="card-body p-5">
            <h3 class="text-center mb-4">@ViewData["Title"]</h3>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- First Name -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.FirstName" type="text" class="form-control" placeholder="Иван" />
                    <label asp-for="Input.FirstName">Име</label>
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>

                <!-- Last Name -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.LastName" type="text" class="form-control" placeholder="Вазов" />
                    <label asp-for="Input.LastName">Фамилия</label>
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Имейл</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" placeholder="Password" />
                    <label asp-for="Input.Password">Парола</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm Password" />
                    <label asp-for="Input.ConfirmPassword">Потвърждение на парола</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Profile Picture -->
                <div class="mb-4">
                    <label asp-for="Input.ProfilePicture" class="form-label">Снимка на профила</label>
                    <input asp-for="Input.ProfilePicture" type="file" class="form-control" />
                    <span asp-validation-for="Input.ProfilePicture" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <div class="d-grid">
                    <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg">
                        Регистрация
                    </button>
                </div>

                <!-- Login Link -->
                <div class="text-center mt-4">
                    <p class="mb-0">
                        Вече имате профил?
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Вход</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
