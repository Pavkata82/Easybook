@model IEnumerable<Easybook.Models.Hotel>

@{
    ViewData["Title"] = "Управление на Хотели";
    ViewData["ActivePage"] = "ManageHotels";
}

<h2>Управление на Хотели</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Име на хотел</th>
            <th>Адрес</th>
            <th>Град</th>
            <th>Държава</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.HotelId</td>
                <td>@hotel.Name</td>
                <td>@hotel.Address</td>
                <td>@hotel.City</td>
                <td>@hotel.Country</td>
                <td>
                    <!-- Example Actions (Edit/Delete) -->
                    <a href="@Url.Action("Edit", "Hotel", new { id = hotel.HotelId })" class="btn btn-warning">Редактиране</a>

                    <a href="@Url.Action("Delete", "Hotel", new { id = hotel.HotelId })" class="btn btn-danger"
                       onclick="return confirm('Сигурни ли сте, че искате да изтриете този хотел?');">
                        Изтриване
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
