@model Easybook.Areas.Admin.Models.ViewModels.BookingDetailsViewModel

@{
    ViewData["Title"] = "Детайли за резервация";
    ViewData["ActivePage"] = "BookingDetails";
}

<div class="container">
    <div class="card shadow-sm mb-4 p-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5><i class="bi bi-tag"></i> Номер на резервация: @Model.BookingId</h5>
            <!-- Status with dropdown toggle -->
            <div class="dropdown">
                <span class="badge
                @(Model.Status == "Отменено" ? "bg-danger" :
                  Model.Status == "В очакване" ? "bg-warning" :
                  Model.Status == "Плащане" ? "bg-info" :
                  Model.Status == "Одобрено" ? "bg-success" : "bg-secondary")
                fs-6 dropdown-toggle"
                      style="cursor: pointer;"
                      id="statusLabel"
                      data-bs-toggle="dropdown"
                      aria-expanded="false">
                    <i class="bi bi-info-circle"></i> @Model.Status
                </span>

                <ul class="dropdown-menu" aria-labelledby="statusLabel">
                    @foreach (var status in ViewBag.Statuses as List<Easybook.Models.Status>)
                    {
                        <li>
                            <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                <input type="hidden" name="statusId" value="@status.Id" />
                                <button type="button" class="dropdown-item @(Model.Status == status.Name ? "active" : "")" onclick="confirmStatusChangeForButton(this)">
                                    @status.Name
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <h4><i class="bi bi-person-circle"></i> Информация за клиента</h4>
                <p><strong>Име:</strong> @Model.CustomerName</p>
                <p><strong>ID на потребителя:</strong> @Model.UserId</p>
                <p>
                    <a href="@Url.Action("Details", "User", new { id = Model.UserId })" class="btn btn-info btn-sm">
                        <i class="bi bi-person-lines-fill"></i> Управление на потребителя
                    </a>
                </p>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <h4><i class="bi bi-buildings"></i> Информация за хотела</h4>
                    <p><strong>Хотел:</strong> @Model.HotelName</p>
                    <p><strong>ID на хотела:</strong> @Model.HotelId</p>
                    <p>
                        <a href="@Url.Action("Edit", "Hotel", new { id = Model.HotelId })" class="btn btn-info btn-sm">
                            <i class="bi bi-building"></i> Управление на хотела
                        </a>
                    </p>
                </div>

                <div class="col-md-6">
                    <h4><i class="bi bi-cash-coin"></i> Обща сума</h4>
                    <div>
                        <p><strong>Обща цена:</strong> <span class="text-success">@Model.TotalPrice.ToString("C", new System.Globalization.CultureInfo("bg-BG"))</span></p>
                        <h5 class="mb-1">
                            <i class="bi bi-credit-card"></i> Платежен статус
                        </h5>
                        <p class="mb-0">
                            @if (Model.IsPaid)
                            {
                                <span class="badge bg-success">Платено</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Неплатено</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <h4><i class="bi bi-calendar-event"></i> Период на резервацията</h4>
                <p>
                    <i class="bi bi-calendar-check"></i> Настаняване: <strong>@Model.CheckInDate.ToString("dd/MM/yyyy")</strong> <br>
                    <i class="bi bi-calendar-x"></i> Напускане: <strong>@Model.CheckOutDate.ToString("dd/MM/yyyy")</strong>
                </p>
                <p><strong>Брой дни:</strong> @Model.NumberOfDays</p>
            </div>

            <div class="mb-3">
                <h4><i class="bi bi-door-closed"></i> Информация за стаите</h4>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="bi bi-door-open"></i> Тип стая</th>
                                <th><i class="bi bi-boxes"></i> Брой</th>
                                <th><i class="bi bi-cash-coin"></i> Цена на стая</th>
                                <th><i class="bi bi-cash-stack"></i> Обща цена</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var roomDetail in Model.RoomDetails)
                            {
                                <tr>
                                    <td>@roomDetail.RoomType</td>
                                    <td><span class="badge bg-secondary">@roomDetail.Quantity</span></td>
                                    <td><span class="text-success">@roomDetail.BookedPrice.ToString("C", new System.Globalization.CultureInfo("bg-BG"))</span></td>
                                    <td><span class="text-success">@roomDetail.TotalPrice.ToString("C", new System.Globalization.CultureInfo("bg-BG"))</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SpecialRequests))
            {
                <div class="mb-3">
                    <h4><i class="bi bi-chat-left-text"></i> Специални изисквания</h4>
                    <p class="text-muted">@Model.SpecialRequests</p>
                </div>
            }
        </div>

        <div class="card-footer text-center">
            <a href="@Url.Action("ManageBookings", "Booking", new { area = "Admin" })" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Обратно към резервациите
            </a>
        </div>
    </div>
</div>

<script src="~/js/status-change.js"></script>