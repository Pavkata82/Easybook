@page
@model Easybook.Areas.Identity.Pages.Account.Manage.BookingsModel
@{
    ViewData["Title"] = "Резервации";
    Layout = "~/Areas/Identity/Pages/Shared/_ManageLayout.cshtml";
    ViewData["ActivePage"] = ManageNavPages.Bookings;
}

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h2 class="mb-4 text-primary">📅 Моите резервации</h2>

        @if (Model.Bookings.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>🏨 Хотел</th>
                            <th>📆 Настаняване</th>
                            <th>📆 Напускане</th>
                            <th>📌 Статус</th>
                            <th>💰 Обща цена</th>
                            <th>⚡ Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td>@booking.Hotel.Name</td>
                                <td>@booking.BookingDateRanges.Min(d => d.StartDate).ToShortDateString()</td>
                                <td>@booking.BookingDateRanges.Max(d => d.EndDate).ToShortDateString()</td>
                                <td>
                                    @if (booking.Status.Name == "В очакване")  // Pending
                                    {
                                        <span class="badge bg-warning">@booking.Status.Name</span>
                                    }
                                    else if (booking.Status.Name == "Плащане")  // Payment
                                    {
                                        <span class="badge bg-info">@booking.Status.Name</span>
                                    }
                                    else if (booking.Status.Name == "Одобрено")  // Approved
                                    {
                                        <span class="badge bg-success">@booking.Status.Name</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@booking.Status.Name</span>
                                        // Cancelled
                                    }
                                </td>
                                <!-- Format Total Price as BGN -->
                                <td><strong>@booking.TotalPrice.ToString("C", new System.Globalization.CultureInfo("bg-BG"))</strong></td>
                                <td class="d-flex flex-column">
                                    <a asp-page="./BookingDetails" asp-route-id="@booking.BookingId" class="btn btn-outline-primary btn-sm">
                                        🔍 Преглед
                                    </a>

                                    @if (booking.Status.Name == "Плащане")
                                    {
                                        <a asp-controller="Payment" asp-action="Checkout" asp-area="" asp-route-bookingId="@booking.BookingId" class="btn btn-success btn-sm d-block mt-2">
                                            💳 Плати сега
                                        </a>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center mt-4">
                <img src="https://cdn-icons-png.flaticon.com/512/4076/4076406.png" alt="Няма резервации" width="150" class="mb-3">
                <h4 class="text-muted">Все още нямате резервации.</h4>
                <a asp-area="Hotels" asp-page="/Browse" class="btn btn-primary mt-3">Разгледайте хотели 🏨</a>
            </div>
        }
    </div>
</div>
