@model IEnumerable<Easybook.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
    ViewData["ActivePage"] = "ManageUsers";
}

<h2>Manage Users</h2>
<hr />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@(user.PhoneNumber ?? "N/A")</td>
                <td>
                    <a href="@Url.Action("Details", "User", new { id = user.Id, area = "Admin" })" class="btn btn-info btn-sm">
                        View Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
