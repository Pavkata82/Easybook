@using System.Globalization
@model Easybook.Models.ViewModels.HotelViewModel

@{
    ViewData["Title"] = Model.Name;
}

<link rel="stylesheet" href="~/css/hotel-details-page.css" />

<div class="container my-5">
    <div class="hotel-details">
        <!-- Hotel Images Section with Carousel -->
        <div class="hotel-images">
            <div id="hotelImageCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @foreach (var imageUrl in Model.Images)
                    {
                        <div class="carousel-item @(Model.Images.IndexOf(imageUrl) == 0 ? "active" : "")">
                            <img src="@imageUrl" class="d-block w-100" alt="Hotel Image">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#hotelImageCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#hotelImageCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>

        <h2>@Model.Name</h2>
        <p class="hotel-description">@Model.Description</p>

        <div class="hotel-info">
            <div class="room-types">
                <strong>Видове стаи:</strong>
                @if (Model.RoomTypes != null && Model.RoomTypes.Any())
                {
                    @string.Join(", ", Model.RoomTypes)
                }
                else
                {
                    <p>Няма видове стаи.</p>
                }
            </div>

            <div class="price">
                <strong>Цена на нощувка:</strong> @Model.PricePerNight.ToString("C", new CultureInfo("bg-BG"))
            </div>

            <a href="@Url.Action("Index", "Hotel", new {
                checkInDate = Context.Request.Query["checkInDate"],
                checkOutDate = Context.Request.Query["checkOutDate"],
                adults = Context.Request.Query["adults"],
                kids = Context.Request.Query["kids"]
            })" class="btn btn-secondary mt-4">
                Назад към списъка с хотели
            </a>
        </div>
        <div class="combination">
            <div class="best-combinations">
                <h3>Най-добри комбинации</h3>

                @if (Model.ExactFitCombination != null && Model.ExactFitCombination.Any())
                {
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Точна комбинация</h5>
                            <ul>
                                @foreach (var room in Model.ExactFitCombination.Split(';'))
                                {
                                    var roomParts = room.Split(':');
                                    if (roomParts.Length == 2)
                                    {
                                        <li>@roomParts[0] - @roomParts[1] стая(и)</li>
                                    }
                                }
                            </ul>
                            <form asp-action="BookingGet" asp-controller="Booking" method="GET">
                                <input hidden name="HotelId" value=@Model.HotelId />
                                <input hidden name="SelectedCombination" value="@Model.ExactFitCombination" />
                                <input hidden name="CheckInDate" value=@Context.Request.Query["checkInDate"] />
                                <input hidden name="CheckOutDate" value=@Context.Request.Query["checkOutDate"] />
                                <button type="submit" class="btn btn-primary w-100">Резервирай сега</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Message to the user to make their own configuration for the rooms -->
                    <div class="alert alert-warning">
                        Няма точна комбинация за избраните от вас параметри. Моля, конфигурирайте вашето собствено настаняване в полето за персонализирана комбинация. 
                    </div>
                }
            </div>

            <div class="custom-combination">
                <h3>Персонализирана комбинация</h3>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="IsCustomCombinationPossible" method="POST">
                    <input type="hidden" name="HotelId" value="@Model.HotelId" />
                    <input type="hidden" name="CheckInDate" value="@Context.Request.Query["checkInDate"]" />
                    <input type="hidden" name="CheckOutDate" value="@Context.Request.Query["checkOutDate"]" />
                    <input type="hidden" name="Adults" value="@Context.Request.Query["adults"]" />
                    <input type="hidden" name="Kids" value="@Context.Request.Query["kids"]" />

                    <!-- Render Room Cards for each Room Type -->
                    @foreach (var roomType in Model.RoomTypes)
                    {
                        <div class="room-card">
                            <div class="room-type">
                                <span>Брой стаи за тип @roomType:</span>
                            </div>
                            <div class="room-controls">
                                <button type="button" class="btn" onclick="decreaseRoomCount('@roomType')">
                                    <i class="bi bi-dash"></i> <!-- Bootstrap Icon: Dash -->
                                </button>
                                <span class="count" id="count-@roomType">0</span>
                                <button type="button" class="btn" onclick="increaseRoomCount('@roomType')">
                                    <i class="bi bi-plus"></i> <!-- Bootstrap Icon: Plus -->
                                </button>
                            </div>
                            <input type="hidden" name="RoomTypeCounts[@roomType]" id="input-@roomType" value="0" />
                        </div>
                    }

                    <button type="submit" class="btn btn-warning w-100">Проверете наличността</button>
                </form>
            </div>
        </div>


        <!-- Reviews Section -->
        <div class="reviews mt-5">
            <h3 class="mb-4">Отзиви</h3>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                @foreach (var review in Model.Reviews)
                {
                    <div class="card review-card mb-3 shadow-sm">
                        <div class="card-body d-flex align-items-start">
                            <img src="@review.User.ProfilePictureUrl" class="rounded-circle me-3" alt="User Image" style="width: 50px; height: 50px; object-fit: cover;">

                            <div class="review-content">
                                <div class="review-header d-flex justify-content-between">
                                    <div>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a href="@Url.Action("Details", "User", new {area = "Admin", id = review.User.Id })" class="fw-bold text-decoration-none text-primary">
                                                @review.User.FirstName @review.User.LastName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="fw-bold">@review.User.FirstName @review.User.LastName</span>
                                        }
                                        <small class="text-muted"> - @review.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>

                                <p class="mt-2">@review.Comment</p>

                                <div class="review-rating">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Няма отзиви за този хотел.</p>
            }
        </div>


        <!-- Add New Review Form -->
        <div class="add-review mt-5">
            <h3 class="mb-4">Добави отзив</h3>

            <div class="card shadow-sm p-4">
                <form asp-action="AddReview" method="POST" class="needs-validation" novalidate>
                    <!-- Star Rating Input -->
                    <div class="form-group mb-3">
                        <label class="form-label">Рейтинг:</label>
                        <div class="rating-input d-flex">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star text-secondary rating-star"
                                   data-value="@i"
                                   onclick="setRating(@i)"></i>
                            }
                        </div>
                        <input type="hidden" name="Rating" id="rating" value="0" required />
                        <div class="invalid-feedback">Моля, дайте рейтинг (1-5 звезди).</div>
                    </div>

                    <!-- Comment Input -->
                    <div class="form-group mb-3">
                        <label class="form-label" for="Comment">Коментар:</label>
                        <textarea name="Comment" id="Comment" class="form-control" rows="4" placeholder="Споделете своя опит..." required></textarea>
                        <div class="invalid-feedback">Моля, въведете коментар.</div>
                    </div>

                    <!-- Hidden HotelId -->
                    <input type="hidden" name="HotelId" value="@Model.HotelId" />

                    <!-- Hidden UserId -->
                    <input type="hidden" name="UserId" value="@Model.UserId" />

                    <!-- Return URL for redirect including query parameters -->
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 mt-2">Изпрати отзив</button>
                </form>
            </div>
        </div>


    </div>
</div>

<script type="text/javascript">
    function increaseRoomCount(roomType) {
        var countElement = document.getElementById("count-" + roomType);
        var inputElement = document.getElementById("input-" + roomType);
        var currentCount = parseInt(countElement.innerText);
        countElement.innerText = currentCount + 1;
        inputElement.value = currentCount + 1;
    }

    function decreaseRoomCount(roomType) {
        var countElement = document.getElementById("count-" + roomType);
        var inputElement = document.getElementById("input-" + roomType);
        var currentCount = parseInt(countElement.innerText);
        if (currentCount > 0) {
            countElement.innerText = currentCount - 1;
            inputElement.value = currentCount - 1;
        }
    }

    function setRating(rating) {
        // Get the current rating from the hidden input
        const currentRating = parseInt(document.getElementById('rating').value);

        // If the clicked rating is the same as the current rating, reset the rating (deselect all stars)
        if (currentRating === rating) {
            rating = 0; // Deselect all stars
        }

        // Set the new rating value to the hidden input
        document.getElementById('rating').value = rating;

        // Get all star icons
        const stars = document.querySelectorAll('.rating-star');

        // Loop through each star to update its appearance
        stars.forEach((star, index) => {
            if (index + 1 <= rating) { // Fill stars up to the selected rating
                // Filled star
                star.classList.remove('bi-star');
                star.classList.add('text-warning');
                star.classList.add('bi-star-fill');
            } else {
                // Empty star
                star.classList.remove('bi-star-fill');
                star.classList.remove('text-warning');
                star.classList.add('bi-star');
            }
        });
    }

    // Form validation on submit
    (function () {
        'use strict';
        const forms = document.querySelectorAll('.needs-validation');

        Array.from(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>