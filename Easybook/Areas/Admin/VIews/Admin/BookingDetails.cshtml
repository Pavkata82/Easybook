@model Easybook.Areas.Admin.Models.ViewModels.BookingDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4">Booking Details</h2>

<div class="container">
    <!-- Booking Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5>Booking ID: @Model.BookingId</h5>
        </div>
        <div class="card-body">
            <h4>Customer Information</h4>
            <p><strong>Customer Name:</strong> @Model.CustomerName</p>
            <p><strong>Status:</strong> <span class="badge bg-@(Model.Status == "Approved" ? "success" : "warning")">@Model.Status</span></p>

            <h4>Hotel Information</h4>
            <p><strong>Hotel:</strong> @Model.HotelName</p>
            <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("C")</p>

            <h4>Booking Date Range</h4>
            <ul>
                @foreach (var range in Model.RoomDetails)
                {
                    <li>@range.RoomType</li>
                }
            </ul>

            <h4>Room Information</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Room Type</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var roomDetail in Model.RoomDetails)
                        {
                            <tr>
                                <td>@roomDetail.RoomType</td>
                                <td>@roomDetail.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h4>Special Requests</h4>
            <p>@Model.SpecialRequests</p>
        </div>
        <div class="card-footer text-center">
            <a href="@Url.Action("ManageBookings", "Admin", new { area = "Admin" })" class="btn btn-secondary">Back to Bookings</a>
        </div>
    </div>
</div>
