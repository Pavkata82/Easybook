@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Extend from main layout if needed
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Toggle Button for Small Screens -->
        <button class="btn btn-dark d-md-none my-3 mx-auto d-block fs-4 py-2 px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
            ☰ Админ панел
        </button>

        <!-- Sidebar for Larger Screens -->
        <div class="col-md-3 col-lg-2 d-none d-md-block bg-dark text-white sidebar">
            @Html.Partial("_AdminSidebar")
        </div>

        <!-- Offcanvas Sidebar for Small Screens -->
        <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="adminSidebarLabel">Административен Панел</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                @Html.Partial("_AdminSidebar")
            </div>
        </div>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            @RenderBody()
        </main>
    </div>
</div>