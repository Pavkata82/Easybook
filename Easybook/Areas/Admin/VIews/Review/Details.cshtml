@model Easybook.Models.Review
@{
    ViewData["Title"] = "Детайли на отзив"; // Set the title of the page
}
<div class="d-flex justify-content-between align-items-center">
    <h2>Детайли на отзив</h2>
    <form method="post" asp-action="Delete" asp-route-id="@Model.ReviewId" class="d-inline">
        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Сигурни ли сте, че искате да изтриете този отзив?');">
            <i class="bi bi-trash"></i> Изтрий
        </button>
    </form>
</div>


<div class="card">
    <div class="card-body">
        <h5 class="card-title">Информация за отзива</h5>
        <p><strong>Име на потребителя:</strong> @Model.User.UserName</p>
        <p><strong>Рейтинг:</strong> @Model.Rating</p>
        <p><strong>Дата на отзив:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
        <p><strong>Коментар:</strong> @Model.Comment</p>
        <p><strong>Хотел:</strong> @Model.Hotel.Name</p>
    </div>
</div>

<!-- Add a button to go back to the review management page -->
<div class="mt-3">
    <a href="@Url.Action("ManageReviews", "Review", new { area = "Admin" })" class="btn btn-primary">
        <i class="bi bi-arrow-left"></i> Назад към управлението на отзиви
    </a>
</div>
