@model IEnumerable<Easybook.Models.Hotel>

<h2>Управление на Хотели</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Име на хотел</th>
            <th>Адрес</th>
            <th>Град</th>
            <th>Държава</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.HotelId</td>
                <td>@hotel.Name</td>
                <td>@hotel.Address</td>
                <td>@hotel.City</td>
                <td>@hotel.Country</td>
                <td>
                    <!-- Example Actions (Edit/Delete) -->
                    <a href="@Url.Action("Edit", "Hotel", new { id = hotel.HotelId })" class="btn btn-warning">Редактиране</a>

                    <form asp-action="Delete" asp-controller="Hotel" method="post" class="d-inline" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този хотел?');">
                        <input type="hidden" name="id" value="@hotel.HotelId" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Изтрий
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
