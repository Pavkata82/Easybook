@{
    var hotelId = ViewBag.HotelId as int?;
    var fullName = ViewBag.FullName as string;
}

<div class="container">
    <h3>Успешна резервация</h3>
    <p>Благодарим Ви, @fullName, за Вашата резервация!</p>
    <p>Очакваме Ви в хотел с ID: @hotelId.</p>
    <a href="/" class="btn btn-primary">Върнете се към началната страница</a>
</div>
