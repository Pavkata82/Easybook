@model IEnumerable<Easybook.Models.Hotel>

@{
    ViewData["Title"] = "Управление на Хотели";
    ViewData["ActivePage"] = "ManageHotels";
}

<h2>Управление на Хотели</h2>

<!-- Search Form -->
<form method="get" class="mb-3">
    <div class="d-flex justify-content-between">
        <div class="input-group">
            <input type="text" class="form-control" name="searchTerm" placeholder="Търсене по ID или име на хотел" value="@Context.Request.Query["searchTerm"]" />
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i> Търси
            </button>
        </div>
    </div>
</form>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Име на хотел</th>
            <th>Град</th>
            <th>Държава</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.HotelId</td>
                <td>@hotel.Name</td>
                <td>@hotel.City</td>
                <td>@hotel.Country</td>
                <td>
                    <!-- Example Actions (Edit/Delete) -->
                    <a href="@Url.Action("Edit", "Hotel", new { id = hotel.HotelId })" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i> Редактиране</a>

                    <a href="@Url.Action("Details", "Hotel", new { id = hotel.HotelId })" class="btn btn-sm btn-info me-1"><i class="bi bi-eye"></i> Детайли</a>

                    <a href="@Url.Action("Delete", "Hotel", new { id = hotel.HotelId })" class="btn btn-sm btn-danger me-1"
                       onclick="return confirm('Сигурни ли сте, че искате да изтриете този хотел?');">
                        <i class="bi bi-trash"></i>
                        Изтриване
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
