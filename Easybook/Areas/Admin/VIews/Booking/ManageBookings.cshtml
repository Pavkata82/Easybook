@model IEnumerable<Easybook.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
    ViewData["ActivePage"] = "ManageBookings";
}

<h2>Manage Bookings</h2>
<p>Here you can approve, cancel, or edit bookings.</p>

<!-- Table for listing bookings -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>All Bookings</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer Name</th>
                            <th>Booking Date Range</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>@booking.BookingId</td>
                                <td>@(booking.User?.FirstName + " " + booking.User?.LastName ?? "N/A")</td>

                                <!-- Display the booking date range (assuming the first date range) -->
                                <td>
                                    @if (booking.BookingDateRanges?.Any() == true)
                                    {
                                        var firstRange = booking.BookingDateRanges.FirstOrDefault();
                                        var startDate = firstRange?.StartDate.ToString("dd/MM/yyyy");
                                        var endDate = firstRange?.EndDate.ToString("dd/MM/yyyy");

                                        @($"{startDate} - {endDate}")
                                    }
                                    else
                                    {
                                        <span>No Date Range Available</span>
                                    }
                                </td>

                                <!-- Status Dropdown for Changing Status & Colored Status Display -->
                                <td>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <!-- Status Badge with Color -->
                                        <span class="badge
                                                    @(booking.Status.Name == "Отменено" ? "bg-danger" : "")
                                                    @(booking.Status.Name == "В очакване" ? "bg-warning" : "")
                                                    @(booking.Status.Name == "Плащане" ? "bg-info" : "")
                                                    @(booking.Status.Name == "Одобрено" ? "bg-success" : "")
                                              style="min-width: 100px; text-align: center;">
                                            @booking.Status.Name
                                        </span>

                                        <!-- Status Dropdown for Changing Status -->
                                        <form asp-action="UpdateBookingStatus" method="post" class="ms-2">
                                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                            <select name="statusId" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 120px;">
                                                @foreach (var status in ViewBag.Statuses as List<Easybook.Models.Status>)
                                                {
                                                    @if (status.Id == booking.StatusId)
                                                    {
                                                        <option value="@status.Id" selected>
                                                            @status.Name
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@status.Id">
                                                            @status.Name
                                                        </option>
                                                    }
                                                }
                                            </select>

                                        </form>
                                    </div>
                                </td>


                                <!-- Actions -->
                                <td class="d-flex gap-2">
                                    <form asp-action="Delete" asp-controller="Booking" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                        <input type="hidden" name="id" value="@booking.BookingId" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Cancel
                                        </button>
                                    </form>

                                    <a href="@Url.Action("BookingDetails", "Booking", new { area = "Admin", id = booking.BookingId })" class="btn btn-info btn-sm" title="View Details">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
