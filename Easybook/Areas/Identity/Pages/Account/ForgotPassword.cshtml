@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забравена парола?";
}
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg rounded-4 p-4" style="max-width: 500px; width: 100%;">
        <div class="card-body">
            <h1 class="card-title text-center mb-3">@ViewData["Title"]</h1>
            <p class="text-muted text-center">Моля, въведете имейла, с който сте се регистрирали.</p>
            <hr />

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Имейл" />
                    <label asp-for="Input.Email">Имейл адрес</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Изпрати линк за възстановяване</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
