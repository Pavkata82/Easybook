@model IEnumerable<Easybook.Models.Review>
@{
    ViewData["Title"] = "Управление на отзиви"; // Set the title of the page
    ViewData["ActivePage"] = "ManageReviews"; // Set the active page for the navbar
}

<h2>Управление на отзиви</h2>

<!-- Search Form (Optional) -->
<form method="get" class="mb-3">
    <div class="d-flex justify-content-between">
        <div class="input-group">
            <input type="text" class="form-control" name="search" placeholder="Търсене по имейл на потребител" value="@Context.Request.Query["search"]" />
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i> Търси
            </button>
        </div>
    </div>
</form>

<!-- Table of Reviews -->
<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Имейл на потребителя</th>
                <th scope="col">Рейтинг</th>
                <th scope="col">Дата</th>
                <th scope="col">Хотел</th>
                <th scope="col">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var review in Model)
            {
                <tr>
                    <!-- Correctly render the UserName from the associated User navigation property -->
                    <td>@review.User.UserName</td>
                    
                    <!-- Render the rating (assuming it's a number between 1 and 5) -->
                    <td>@review.Rating</td>
                    
                    <!-- Render the creation date and format it properly -->
                    <td>@review.CreatedAt.ToString("dd/MM/yyyy")</td>
                    
                    <!-- Render the hotel name from the associated Hotel navigation property -->
                    <td>@review.Hotel.Name</td>

                    <td>
                        <a href="@Url.Action("Details", "Review", new { id = review.ReviewId, area = "Admin" })"
                           class="btn btn-sm btn-info me-1">
                            <i class="bi bi-eye"></i> Детайли
                        </a>
                        <form method="post" asp-action="Delete" asp-route-id="@review.ReviewId" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Сигурни ли сте, че искате да изтриете този отзив?');">
                                <i class="bi bi-trash"></i> Изтрий
                            </button>
                        </form>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
