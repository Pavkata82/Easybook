@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Extend from main layout if needed
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Toggle Button for Small Screens -->
        <button class="btn btn-dark d-md-none my-3 ms-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
            ☰ Админ панел
        </button>

        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 d-none d-md-block bg-dark text-white sidebar">
            @Html.Partial("_AdminSidebar")
        </div>

        <!-- Offcanvas Sidebar for Small Screens -->
        <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="adminSidebar">
            @Html.Partial("_AdminSidebar")
        </div>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            @RenderBody()
        </main>
    </div>
</div>

<!-- Ensure Bootstrap JS is included -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
