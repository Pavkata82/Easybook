<div class="offcanvas-body p-3">
    <h4 class="text-center my-3">Админ Панел</h4>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "Index" ? "active bg-primary" : "")"
               asp-area="Admin" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-house-door-fill"></i> Начало
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "ManageUsers" ? "active bg-primary" : "")"
               asp-area="Admin" asp-controller="User" asp-action="ManageUsers">
                <i class="bi bi-people"></i> Управление на потребители
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "ManageBookings" ? "active bg-primary" : "")"
               asp-area="Admin" asp-controller="Booking" asp-action="ManageBookings">
                <i class="bi bi-calendar-check"></i> Управление на резервации
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "CreateHotel" ? "active bg-primary" : "")"
               asp-area="Admin" asp-controller="Hotel" asp-action="Create">
                <i class="bi bi-building-add"></i> Добави хотел
            </a>
        </li>
        <!-- New section for "Hotel Management" -->
        <li class="nav-item">
            <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "ManageHotels" ? "active bg-primary" : "")"
               asp-area="Admin" asp-controller="Hotel" asp-action="ManageHotels">
                <i class="bi bi-buildings"></i> Управление на хотели
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "Settings" ? "active bg-primary" : "")"
               href="#">
                <i class="bi bi-gear"></i> Настройки
            </a>
        </li>
    </ul>
</div>
