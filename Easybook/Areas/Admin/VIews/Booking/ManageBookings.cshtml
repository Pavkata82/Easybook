@model IEnumerable<Easybook.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Manage Bookings</h2>
<p>Here you can approve, cancel, or edit bookings.</p>

<!-- Table for listing bookings -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>All Bookings</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer Name</th>
                            <th>Booking Date Range</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>@booking.BookingId</td>
                                <td>@booking.User?.UserName</td>

                                <!-- Display the booking date range (assuming the first date range) -->
                                <td>
                                    @if (booking.BookingDateRanges?.Any() == true)
                                    {
                                        var firstRange = booking.BookingDateRanges.FirstOrDefault();
                                        var startDate = firstRange?.StartDate.ToString("dd/MM/yyyy");
                                        var endDate = firstRange?.EndDate.ToString("dd/MM/yyyy");

                                        @($"{startDate} - {endDate}")
                                    }
                                    else
                                    {
                                        <span>No Date Range Available</span>
                                    }
                                </td>


                                <td>
                                    <span class="badge bg-@(booking.Status.Name == "Approved" ? "success" : "warning")">
                                        @booking.Status.Name
                                    </span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "Booking", new { id = booking.BookingId })" class="btn btn-primary btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", "Booking", new { id = booking.BookingId })" class="btn btn-danger btn-sm" title="Cancel">
                                        <i class="bi bi-trash"></i> Cancel
                                    </a>
                                    <a href="@Url.Action("BookingDetails", "Booking", new { area = "Admin", id = booking.BookingId })" class="btn btn-info btn-sm" title="View Details">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
