@{
    ViewData["Title"] = "Успешно плащане!";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body text-center">
                    <!-- Success Icon -->
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h2 class="mt-4">Успешно плащане!</h2>
                    <p class="lead">Благодарим ви за вашето резервационно плащане. Вашето плащане беше обработено успешно.</p>

                    <!-- Return to Home Button -->
                    <a href="@Url.Page("/Account/Manage/Bookings", new { area = "Identity" })" class="btn btn-primary btn-lg mt-3">
                        <i class="bi bi-house-door"></i> Мои резервации
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>