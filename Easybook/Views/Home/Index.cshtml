@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/index-page.css" asp-append-version="true" />

<div class="container-fluid hero">
    <div class="row">
        <div class="col-md-12 d-flex flex-column align-items-center">
            <p class="display-1 text-white fw-bold mb-2">Easybook</p>
            <p class="lead text-light fw-semibold mb-5">
                Прави резервациите ти лесни...
            </p>

            @if (ViewData["ErrorMessages"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["ErrorMessages"]
                </div>
            }

            <form class="form-container bg-white p-4 rounded shadow" method="GET" action="@Url.Action("Index", "Hotel")">
                <div class="row g-3 mb-3">
                    <!-- Search Input for City or Hotel Name -->
                    <div class="col-12">
                       <input type="text" class="form-control" id="searchQuery" name="searchQuery"
                               placeholder="Въведи град или име на хотел..." />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="checkInDate" class="form-label text-dark">Дата на настаняване</label>
                        <input type="date" class="form-control" id="checkInDate" name="checkInDate" required />
                    </div>
                    <div class="col-sm-6">
                        <label for="checkOutDate" class="form-label text-dark">Дата на напускане</label>
                        <input type="date" class="form-control" id="checkOutDate" name="checkOutDate" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <select class="form-select" id="adults" name="adults">
                            <option value="1">1 Възрастен</option>
                            <option value="2">2 Възрастни</option>
                            <option value="3">3 Възрастни</option>
                            <option value="4">4 Възрастни</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <select class="form-select" id="kids" name="kids">
                            <option value="0">Без деца</option>
                            <option value="1">1 Дете</option>
                            <option value="2">2 Деца</option>
                            <option value="3">3 Деца</option>
                            <option value="4">4 Деца</option>
                            <option value="5">5 Деца</option>
                        </select>
                    </div>
                </div>

                <button id="submit-btn" type="submit">Търси</button>
            </form>


        </div>
    </div>
</div>

<script src="~/js/datepicker.js"></script>


